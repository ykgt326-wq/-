[Unit]
Description=Enable USB keyboard/mouse wakeup from suspend (boot-time)
Documentation=https://www.kernel.org/doc/Documentation/ABI/testing/sysfs-class-wakeup
After=multi-user.target
ConditionPathExists=/proc/acpi/wakeup

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/enable-usb-wakeup.sh

[Install]
WantedBy=multi-user.target
