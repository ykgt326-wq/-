# USB HIDデバイス（キーボード・マウス）をスリープから復帰できるよう設定
# DEVTYPE=="usb_device" でデバイスノードを対象にする（インターフェースノードではない）
# ATTRS{} は親チェーンを辿って一致を検索する

# HIDクラス (0x03) を持つUSBデバイスのwakeupを有効化
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", \
    ATTRS{bInterfaceClass}=="03", \
    ATTR{power/wakeup}="enabled"

# キーボード (HIDサブクラス=01, プロトコル=01) のwakeupを有効化
# ワイヤレスレシーバーなど複合デバイス用
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", \
    ATTRS{bInterfaceSubClass}=="01", ATTRS{bInterfaceProtocol}=="01", \
    ATTR{power/wakeup}="enabled"

# マウス (HIDサブクラス=01, プロトコル=02) のwakeupを有効化
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", \
    ATTRS{bInterfaceSubClass}=="01", ATTRS{bInterfaceProtocol}=="02", \
    ATTR{power/wakeup}="enabled"
